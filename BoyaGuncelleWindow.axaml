<!-- =========================-->
<!-- İÇ CEPHE BOYASI GÜNCELLEME FORMU-->
<!-- =========================-->


<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Paint.Views.BoyaGuncelleWindow"
        Width="450"
        Height="590"
        Title="Boya Güncelle"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

<Border
Padding="30"
Background="#F5F7FA">

<StackPanel Spacing="12">

  <!-- BAŞLIK -->
   
    <TextBlock
        Text="Boya Güncelle"
        FontSize="26"
        FontWeight="Bold"
        Foreground="#092A4A"
        HorizontalAlignment="Center"
        Margin="0,0,0,10"/>

  <!-- BOYA ADI -->

    <TextBlock
        Text="Boya Adı"
        FontWeight="SemiBold"/>

    <TextBox
        x:Name="BoyaAdiTextBox"
        Height="40"
        Watermark="Boya adını giriniz"/>


 <!-- AÇIKLAMA --> 

    <TextBlock
        Text="Açıklama"
        FontWeight="SemiBold"/>

    <TextBox
        x:Name="AciklamaTextBox"
        Height="80"
        AcceptsReturn="True"
        TextWrapping="Wrap"
        Watermark="Açıklama giriniz"/>

  <!-- STOK -->

    <TextBlock
        Text="Stok"
        FontWeight="SemiBold"/>

    <NumericUpDown
        x:Name="StokNumericUpDown"
        Height="40"
        Minimum="0"
        Maximum="100000"
        Increment="1"
        FormatString="0"
        Value="0"/>


   <!-- FİYAT -->       

    <TextBlock
        Text="Birim Fiyat"
        FontWeight="SemiBold"/>

    <NumericUpDown
        x:Name="FiyatNumericUpDown"
        Height="40"
        Minimum="0"
        Maximum="1000000"
        Increment="1"
        FormatString="0.00"
        Value="0"/>


   <!-- HATA MESAJI --> 

    <TextBlock
        x:Name="ResultTextBlock"
        Foreground="#D64545"
        FontSize="14"
        FontWeight="SemiBold"
        HorizontalAlignment="Center"
        TextAlignment="Center"
        TextWrapping="Wrap"
        Margin="0,5,0,0"/>

    <Grid
        ColumnDefinitions="*,*"
        ColumnSpacing="10"
        Margin="0,10,0,0">


<!-- İÇ CEPHE BOYASI GÜNCELLEME FORMUNDA İPTAL BUTONU-->
     
    <Button
        Grid.Column="0"
        Content="İptal"
        Height="42"
        Background="#E53935"
        Foreground="White"
        CornerRadius="8"
        HorizontalContentAlignment="Center"
        Click="IptalButton_Click"/>

<!-- İÇ CEPHE BOYASI GÜNCELLEME FORMUNDA GÜNCELLE BUTONU--> 
        
    <Button
        Grid.Column="1"
        Content="Güncelle"
        Height="42"
        Background="#1677FF"
        Foreground="White"
        CornerRadius="8"
        FontWeight="SemiBold"
        HorizontalContentAlignment="Center"
        Click="GuncelleButton_Click"/>

    </Grid>

</StackPanel>

</Border>

</Window>