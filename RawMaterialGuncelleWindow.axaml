<!-- ================================================ -->
<!-- HAMMADDE GÜNCELLEME FORMU -->
<!-- ================================================ -->  


<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Paint.Views.RawMaterialGuncelleWindow"
        Width="450"
        Height="720"
        Title="Hammadde Güncelle"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

<Border
    Padding="30"
    Background="#F5F7FA">

<StackPanel Spacing="12">

<TextBlock
    Text="Hammadde Güncelle"
    FontSize="26"
    FontWeight="Bold"
    Foreground="#092A4A"
    HorizontalAlignment="Center"
    Margin="0,0,0,10"/>

<TextBlock
    Text="Hammadde Adı"
    FontWeight="SemiBold"/>

<TextBox
    x:Name="MaterialNameTextBox"
    Height="40"/>

<TextBlock
    Text="Açıklama"
    FontWeight="SemiBold"/>

<TextBox
    x:Name="ExplanationTextBox"
    Height="80"
    AcceptsReturn="True"
    TextWrapping="Wrap"/>

<TextBlock
    Text="Stok"
    FontWeight="SemiBold"/>

<NumericUpDown
    x:Name="StockNumericUpDown"
    Height="40"
    Minimum="0"
    Maximum="1000000"
    Increment="1"
    FormatString="0"/>

<TextBlock
    Text="Birim Fiyat"
    FontWeight="SemiBold"/>

<NumericUpDown
    x:Name="PriceNumericUpDown"
    Height="40"
    Minimum="0"
    Maximum="1000000"
    Increment="1"
    FormatString="0.00"/>

<TextBlock
    Text="Fotoğraf Yolu"
    FontWeight="SemiBold"/>

<TextBox
    x:Name="PictureTextBox"
    Height="40"/>

<TextBlock
    x:Name="ResultTextBlock"
    Foreground="#D64545"
    FontSize="14"
    FontWeight="SemiBold"
    HorizontalAlignment="Center"
    TextAlignment="Center"
    TextWrapping="Wrap"
    Margin="0,5,0,0"/>

<Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="10"
    Margin="0,10,0,0">

<!-- ================================================ -->
<!-- İPTAL BUTONU -->
<!-- ================================================ -->  
    <Button
        Grid.Column="0"
        Content="İptal"
        Height="42"
        Background="#E53935"
        Foreground="White"
        CornerRadius="8"
        HorizontalContentAlignment="Center"
        Click="IptalButton_Click"/>


<!-- ================================================ -->
<!-- GÜNCELLE BUTONU -->
<!-- ================================================ -->          
    <Button
        Grid.Column="1"
        Content="Güncelle"
        Height="42"
        Background="#1677FF"
        Foreground="White"
        CornerRadius="8"
        FontWeight="SemiBold"
        HorizontalContentAlignment="Center"
        Click="GuncelleButton_Click"/>

            </Grid>

        </StackPanel>

    </Border>

</Window>